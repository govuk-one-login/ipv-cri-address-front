{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "ipv-cri-address",
      "component": "ipv-cri-address",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/code-quality.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            }
          ],
          "file": ".github/workflows/check-pr.yml",
          "path": "$.jobs.unit-tests"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.coverage"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": ["regression", "new feature"],
              "scope": "component"
            }
          ],
          "file": ".github/workflows/check-pr.yml",
          "path": "$.jobs.browser-tests"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.sonarcloud"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "visual regression"
            }
          ],
          "file": ".github/workflows/run-browser-tests.yml",
          "path": "$.jobs.visual-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.sonarcloud"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.codeql"
        }
      ]
    }
  ]
}
