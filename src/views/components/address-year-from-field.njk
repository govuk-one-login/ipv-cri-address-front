{% macro yearFromField(ctx, params) %}
  {% from "govuk/components/input/macro.njk" import govukInput %}

  <h2 class="govuk-heading-s">{{ params.title }}</h2>

  {{ govukInput({
    id: params.name,
    name: params.name,
    value: fieldValues[params.name],
    errorMessage: fieldErrors[params.name],
    label: { text: params.label },
    classes: "govuk-input--width-4",
    hint: { text: "" },
    type: "text",
    inputmode: "numeric",
    attributes: { "spellcheck": "false", "autocomplete": "on" }
  }) }}
{% endmacro %}
