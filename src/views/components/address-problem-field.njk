{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

<h1 id="header" class="govuk-heading-l">{{translate("pages.addressProblem.title")}}</h1>
<form method="post">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

  {{hmpoHtml(translate("pages.addressProblem.content"))}}

  {{ govukRadios({ idPrefix: "addressBreak", name: "addressBreak", errorMessage: fieldErrors.addressBreak, fieldset: { legend: { text: translate("addressBreak.legend"), isPageHeading: true, classes: "govuk-fieldset__legend--l" } }, items: fieldItems.addressBreak or [] }) }}

  {{ govukButton({ id: "continue", text: translate("buttons.next"), preventDoubleClick: true, attributes: { "data-nav": "true", "data-link": "/undefined" } }) }}

 {{hmpoHtml(translate("links.helpContact"))}}

</form>
