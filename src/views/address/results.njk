{% extends "base-form.njk" %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% set hmpoPageKey = "address-results" %}
{% set hmpoPageContent = "address-results" %}
{% set gtmJourney = "address - middle" %}

{% set isPageDataSensitive = true %}
{% set statusCode = '200' %}
{% set pageTitleKey = "pages.address-results.title" %}
{% set contentID = "06f6fd28-448d-4207-a012-0ef7aa2fef67" %}
{% set taxLevel2 = 'address' %}
{% set isPageDynamic = false %}
{% set loggedInStatus = true %}


{% block mainContent %}

  <h1 id="header" class="govuk-heading-l">{{translate("pages.address-results.title")}}</h1>

  {{hmpoHtml(translate("links.changePostcode"))}}

  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

  {{ govukSelect({ id: "addressResults", name: "addressResults", value: fieldValues.addressResults, errorMessage: fieldErrors.addressResults, label: { text: translate("addressResults.label") }, items: fieldItems.addressResults or [] }) }}

  {{ hmpoHtml(translate("links.cantFindAddress")) }}

  {{ govukButton({ id: "continue", text: translate("buttons.select-address"), preventDoubleClick: true, attributes: { "data-nav": "true", "data-link": "/undefined" } }) }}

  </form>

{% endblock %}
