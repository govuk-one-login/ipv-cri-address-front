{% extends "base-form.njk" %}
{% from "frontend-ui/build/components/form/macro.njk" import form %}
{% from "frontend-ui/build/components/select/macro.njk" import select %}
{% from "frontend-ui/build/components/submit/macro.njk" import submit %}
{% from "frontend-ui/build/components/html/macro.njk" import html %}
{% set hmpoPageKey = "address-previous-results" %}
{% set hmpoPageContent = "address-previous-results" %}
{% set gtmJourney = "address - prev - middle" %}

{% set isPageDataSensitive = true %}
{% set statusCode = '200' %}
{% set pageTitleKey = "pages.address-previous-results.title" %}
{% set contentID = "083cb516-b395-47a1-971b-8dfc0f900dea" %}
{% set taxLevel2 = 'address' %}
{% set isPageDynamic = false %}
{% set loggedInStatus = true %}

{% block mainContent %}

  <h1 id="header" class="govuk-heading-l">{{translate("pages.address-previous-results.title")}}</h1>

  {{html(translate("links.previous.changePostcode"))}}

  {% call form(ctx) %}

  {{ select(ctx, {
      id: "addressResults",
      label: translate("fields.addressResultsPrevious.label"),
      hint: "",
      items: addresses
    }) }}

  {{ html(translate("links.previous.cantFindAddress")) }}

  {{ submit(ctx, {attributes: {"data-nav": true, "data-link": "/previous-address-check"}, id: "continue", text: translate("buttons.select-address")}) }}

  {% endcall %}

{% endblock %}
