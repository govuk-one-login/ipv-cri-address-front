{% extends "cri-base-form.njk" %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set hmpoPageKey = "address-previous-results" %}
{% set hmpoPageContent = "address-previous-results" %}
{% set gtmJourney = "address - prev - middle" %}

{% set isPageDataSensitive = true %}
{% set statusCode = '200' %}
{% set pageTitleKey = "pages.address-previous-results.title" %}
{% set contentID = "083cb516-b395-47a1-971b-8dfc0f900dea" %}
{% set taxLevel2 = 'address' %}
{% set isPageDynamic = false %}
{% set loggedInStatus = true %}

{% block mainContent %}

  <h1 id="header" class="govuk-heading-l">{{translate("pages.address-previous-results.title")}}</h1>

  {% set changePostcodeHtml = translate("links.previous.changePostcode") %}
  {% if changePostcodeHtml is iterable and changePostcodeHtml is not string %}
    {% for item in changePostcodeHtml %}{{ item | safe }}{% endfor %}
  {% elif changePostcodeHtml %}
    {{ changePostcodeHtml | safe }}
  {% endif %}

  <form action="{{ action }}" method="POST" novalidate spellcheck="false">
    <input type="hidden" name="x-csrf-token" value="{{ csrfToken }}">

  {{ govukSelect({
    id: "addressResults",
    name: "addressResults",
    value: formFields.addressResults.value if formFields.addressResults else "",
    label: {
      text: translate("fields.addressResultsPrevious.label")
    },
    errorMessage: formFields.addressResults.errorMessage if formFields.addressResults else undefined,
    items: addresses
  }) }}

  {% set cantFindHtml = translate("links.previous.cantFindAddress") %}
  {% if cantFindHtml is iterable and cantFindHtml is not string %}
    {% for item in cantFindHtml %}{{ item | safe }}{% endfor %}
  {% elif cantFindHtml %}
    {{ cantFindHtml | safe }}
  {% endif %}

  {{ govukButton({
    text: translate("buttons.select-address"),
    attributes: { "id": "continue", "data-nav": "true", "data-link": "/previous-address-check" }
  }) }}

  </form>

{% endblock %}
